{
  "name": "jungle-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "typecheck:perf": "tsc -p perf/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:update": "playwright test visual.spec.ts --project=desktop --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "test:perf:report": "playwright show-report perf-report"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "pixi.js": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "^3.0.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
